# Required: the coach's reasoning model
ANTHROPIC_API_KEY=sk-ant-...

# Required: a Strava API application (https://www.strava.com/settings/api),
# with its Authorization Callback Domain set to "localhost".
# The coach reads Strava's REST API as this app and serves it over its own
# local MCP server; Strava's hosted MCP is closed to third-party clients.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional overrides
# COACH_MODEL=claude-sonnet-5
# COACH_ROUTER_MODEL=claude-haiku-4-5-20251001
# COACH_DATA_MODEL=claude-haiku-4-5-20251001
# COACH_OAUTH_PORT=8765
# COACH_DATA_DIR=./data
# COACH_STATE_DIR=~/.config/coach-graph
